# Court Draft Sim - Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# BallDontLie API (optional - for live player data)
# BALL_DONT_LIE_API_KEY=your_api_key_here

# Database (if using a database in the future)
# DATABASE_URL=postgresql://user:pass@localhost:5432/court_draft_sim