# Court Draft Sim - Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL(s) for CORS (comma-separated allowlist, or single origin)
FRONTEND_URL=http://localhost:5173
# Set to 1 when behind Render/Vercel proxy so rate-limit IPs are correct.
# TRUST_PROXY=0

# Client build-time API base (set in client/.env or Vercel env, NOT root .env —
# Vite only reads client/.env + build-time env). Empty/omitted = same-origin /api.
# VITE_API_URL=https://court-draft-sim.onrender.com/api
# Local dev proxy target for `npm run dev:client` (/api -> server).
# VITE_API_PROXY_TARGET=http://localhost:3001